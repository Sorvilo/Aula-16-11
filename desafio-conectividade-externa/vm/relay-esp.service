[Unit]
Description=Ponte HTTP navegador <-> ESP8266 (Desafio 5)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/Aula-16-11/desafio-conectividade-externa/vm
Environment=RELAY_PORT=8080
# O token real e colocado na hora da instalacao (nao fica no GitHub)
Environment=RELAY_TOKEN=TROQUE_ESTE_TOKEN
ExecStart=/usr/bin/python3 -u servidor_relay.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
